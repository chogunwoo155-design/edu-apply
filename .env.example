# 복사해서 .env로 쓴다 (.env는 git에 올리지 않는다)
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://postgres@127.0.0.1:5432/edu_apply

# 메일: 로컬은 콘솔 출력. 운영은 Amazon SES SMTP 등
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=히어로스쿨 <no-reply@example.com>
STAFF_NOTIFY_EMAILS=staff@example.com
